# ==============================================================================
# SpendWise – Environment Variables Configuration Template
# ==============================================================================
# IMPORTANT SECURITY & DEPLOYMENT INSTRUCTIONS:
# 1. Copy this file to .env before starting the backend server (never commit .env to git).
# 2. Example values below are strictly PLACEHOLDERS and must be replaced with your own credentials.
# 3. In production, configure environment variables via your cloud host's secure environment settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT (NODE_ENV)
# ------------------------------------------------------------------------------
# Controls application security headers, CORS enforcement, and error disclosures.
# - 'development': Permits local development origins (localhost, 127.0.0.1, file://),
#                  disables HSTS for local HTTP testing, and discloses debugging errors.
# - 'production':  Enforces strict HTTPS/HSTS, masks internal errors and database stack traces,
#                  strictly rejects localhost and null CORS origins, and requires FRONTEND_URL.
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. SERVER PORT (PORT)
# ------------------------------------------------------------------------------
# Local development port (default: 5000).
# In cloud PaaS environments (Heroku, Render, Railway), this is often set automatically by the host.
PORT=5000

# ------------------------------------------------------------------------------
# 3. DATABASE CONNECTION (MONGO_URI)
# ------------------------------------------------------------------------------
# MongoDB connection URI (e.g. MongoDB Atlas cluster SRV string or local MongoDB instance).
# IMPORTANT: Replace <username> and <password> with your actual database user credentials.
# Never expose credentials to frontend code or public repositories.
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/spendwise?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/spendwise?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 4. JSON WEB TOKEN (JWT) SECURITY CONFIGURATION
# ------------------------------------------------------------------------------
# JWT_SECRET: Secret key used to sign and verify authentication tokens.
# CRITICAL SECURITY REQUIREMENT:
# In production, this MUST be set to a cryptographically strong, high-entropy, random string
# (minimum 32-64 characters). If JWT_SECRET is missing or empty, backend startup is blocked.
# NEVER reuse development secrets in production.
JWT_SECRET=spendwise_super_secret_jwt_key_2026_change_in_production

# JWT_EXPIRES_IN: Lifespan of user authentication tokens (e.g. '7d' = 7 days, '24h' = 24 hours).
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 5. CROSS-ORIGIN RESOURCE SHARING (CORS) - FRONTEND_URL
# ------------------------------------------------------------------------------
# Specifies trusted web origins permitted to make cross-origin API requests to this backend.
#
# Production Behavior (NODE_ENV=production):
# - FRONTEND_URL is MANDATORY. Startup fails if missing or empty.
# - Localhost, 127.0.0.1, and 'null' origins are STRICTLY FORBIDDEN to prevent cross-site
#   request forgery from unauthorized local applications.
# - Only explicitly configured HTTPS origins are permitted.
# - Specify multiple origins by separating with commas (e.g. production and staging domains).
#   Example: FRONTEND_URL=https://spendwise.example.com,https://staging.spendwise.example.com
#
# Development Behavior (NODE_ENV=development):
# - Standard localhost/127.0.0.1 origins (ports 5500, 3000, 5000, 8080, 8000, 5173) and 'null'
#   (for direct file:// viewing) are permitted by default.
# - Any FRONTEND_URL specified here will be added to the development allowlist.
FRONTEND_URL=https://spendwise.example.com

# ------------------------------------------------------------------------------
# 6. REVERSE PROXY & RATE LIMITING CONFIGURATION (TRUST_PROXY)
# ------------------------------------------------------------------------------
# Configures Express 'trust proxy' setting, which governs how client IP addresses are resolved
# from X-Forwarded-For headers for rate limiting and auditing.
#
# CRITICAL SECURITY GUIDELINES:
# - Local Development: LEAVE UNSET (or false).
#   When connecting directly without a proxy, trusting headers allows attackers to spoof their IP
#   and bypass brute-force rate limits.
#
# - Production Deployment:
#   You MUST determine your actual hosting proxy topology before configuring this setting:
#   * '1' or 'true':   Trust exactly 1 upstream proxy hop. Appropriate for single-tier cloud proxies
#                      such as Render, Railway, Heroku, or standard AWS Application Load Balancers (ALB).
#   * '2':             Trust 2 proxy hops. Appropriate when traffic flows through a CDN and a cloud proxy
#                      (e.g., Cloudflare -> Cloud Load Balancer -> Node.js).
#   * 'loopback':      Trust local reverse proxy on same server (e.g., Nginx or Caddy on localhost).
#   * 'uniquelocal' / Subnet CIDR (e.g. '10.0.0.0/8'): Trust proxies within a private VPC network.
#   * 'false' or '0':  Explicitly disables proxy header trust.
#
# WARNING: If left unset behind a reverse proxy in production, all users will share the proxy's IP,
# and 10 total login attempts across all users will trigger a global rate-limit lockout (HTTP 429).
# Conversely, never blindly set trust proxy to true without specifying hop counts or subnets.
#
# Examples:
# TRUST_PROXY=1
# TRUST_PROXY=loopback
# TRUST_PROXY=10.0.0.0/8
TRUST_PROXY=

# ------------------------------------------------------------------------------
# 7. DNS CONFIGURATION (USE_CUSTOM_DNS) - SEC-FIND-04
# ------------------------------------------------------------------------------
# Governs whether Node.js uses custom public DNS resolvers (Google DNS: 8.8.8.8, 8.8.4.4)
# or the operating system's default DNS resolvers.
#
# Default Behavior:
# - Leaving this unset (or false/0) allows Node.js to use the system DNS resolver.
#
# Development Behavior:
# - On certain Windows machines or home routers, local DNS forwarders drop or reject
#   DNS SRV queries used by MongoDB Atlas (mongodb+srv://), resulting in querySrv ECONNREFUSED.
# - Windows developers encountering this local issue may set USE_CUSTOM_DNS=true.
# - Supported values: 'true', 'false', '1', '0' (or leave unset).
#
# Production Behavior (CRITICAL):
# - This setting is STRICTLY IGNORED in production mode (NODE_ENV=production).
# - Cloud deployments (AWS, GCP, Azure, Kubernetes, Render, Railway, Heroku) MUST use
#   their host operating system / Cloud VPC DNS resolvers to ensure private VPC hostnames
#   (e.g., internal databases, CoreDNS, Route 53) resolve properly.
#
# Examples:
# USE_CUSTOM_DNS=false
USE_CUSTOM_DNS=false
